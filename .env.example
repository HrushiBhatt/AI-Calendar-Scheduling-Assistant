# Copy to .env (which git ignores) and fill in real values. `make api`, `make serve`
# and `make docker` load it automatically. Keep values free of spaces, # and $.
#
# Everything below JWT_SECRET is optional: the app starts and runs with none of it set.
# Each feature degrades on its own (no Google keys: no calendar; no Anthropic key: the
# planning form instead of plain-language requests; no PUBLIC_URL: polling, not push).

# Signs login cookies. Required in production: without it the server makes a random
# key at startup, so everyone is logged out whenever it restarts.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Set to true when served over HTTPS, so cookies are only sent over encrypted connections.
SECURE_COOKIES=false

# ---- Google Calendar (read your meetings; optionally write focus blocks back) ----------
# From the Google Cloud console (see the README). Set all three or none.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the console exactly. With `make web` this is the Angular dev server:
# http://localhost:4200/api/calendar/callback
GOOGLE_REDIRECT_URL=

# Encrypts calendar tokens at rest (AES-256-GCM). Required with Google keys, and once
# any calendar is connected the server refuses to start without it.
# Generate one with: openssl rand -hex 32
CALENDAR_ENC_KEY=

# Public https:// base URL Google can reach for push notifications. Unset, calendars are
# polled every 5 minutes instead, so local development needs no tunnel.
# PUBLIC_URL=https://brew.example.com

# ---- Planning assistant (plain-language requests) --------------------------------------
# Unset, the assistant is off and the planning form does the same job.
ANTHROPIC_API_KEY=
# A small, fast model: this is structured extraction, not open-ended reasoning.
# ASSISTANT_MODEL=claude-haiku-5-5
# Per-user daily token budget for the assistant (input plus output tokens).
# ASSISTANT_DAILY_TOKENS=50000
# output_config.effort for the model; "default" sends none (needed for models without effort).
# ASSISTANT_EFFORT=low

# Optional overrides.
# ADDR=:5001
# DB_PATH=brewfocus.db
# DEMO=true   # seed demo@brewfocus.dev (password: brewfocus) with a fake calendar

# Test doubles for the end-to-end test. Never set these in production.
# CALENDAR_PROVIDER=fake     # "connect" an in-memory calendar instead of Google
# ASSISTANT_PROVIDER=stub    # a phrase-matching stand-in for the model
