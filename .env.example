# This is only a template, and git tracks it: never put real keys in this file.
# Copy it to .env (which git ignores) and fill in real values there. The app reads only
# .env: `make api`, `make serve` and `make docker` load it automatically. Keep values free
# of spaces, # and $, with nothing between the =
#
# Everything is optional for local use: the app starts and runs with none of it set.

# Signs login cookies. At least 32 bytes. With GIN_MODE=release the server won't start
# without it; otherwise it makes a random key, so everyone is logged out when it restarts.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Set to true when served over HTTPS: cookies then only travel over encrypted connections,
# and browsers are told to use HTTPS from now on. The Docker image defaults this to true.
SECURE_COOKIES=

# Behind a reverse proxy or a hosting platform, list its addresses or CIDR ranges, comma
# separated. Rate limits need each visitor's real address, and only these may report it.
# Unset, every visitor would look like the proxy and share one sign-in limit.
# TRUSTED_PROXIES=

# ---- Sign in with Google (optional) ----------------------------------------------------
# From the Google Cloud console. Set all three to turn it on, or none for passwords only.
# The redirect URL must match the console exactly, and be https except on localhost.
# With `make web`: http://localhost:4200/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URL=

# Optional overrides.
# ADDR=
# DB_PATH=
# DEMO=
