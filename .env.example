# This is only a template, and git tracks it: never put real keys in this file.
# Copy it to .env (which git ignores) and fill in real values there. The app reads only
# .env: `make api`, `make serve` and `make docker` load it automatically. Keep values free
# of spaces, # and $, with nothing between the = and the value.
#
# Everything below JWT_SECRET is optional: the app starts and runs with none of it set.
# Each feature degrades on its own (no Google keys: no calendar; no Anthropic key: the
# planning form instead of plain-language requests; no PUBLIC_URL: polling, not push).

# Signs login cookies. At least 32 bytes. With GIN_MODE=release the server refuses to start
# without it; otherwise it makes a random key, so everyone is logged out when it restarts.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Set to true when served over HTTPS: cookies then only travel over encrypted connections,
# and browsers are told to use HTTPS from now on. The Docker image defaults this to true.
SECURE_COOKIES=false

# Behind a reverse proxy or a hosting platform, list its addresses or CIDR ranges, comma
# separated. Rate limits need each visitor's real address, and only these may report it.
# Unset, every visitor would look like the proxy and share one sign-in limit.
# TRUSTED_PROXIES=10.0.0.0/8

# ---- Google (sign-in and calendar use the same OAuth client) ---------------------------
# From the Google Cloud console (see the README). Set the ID and secret together, plus a
# redirect URL for each feature you want. Redirect URLs must be https, except on localhost.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "Continue with Google". Must match the console exactly. With `make web`:
# http://localhost:4200/api/auth/google/callback
GOOGLE_LOGIN_REDIRECT_URL=
# Google Calendar: read your meetings; optionally write focus blocks back. With `make web`:
# http://localhost:4200/api/calendar/callback
GOOGLE_REDIRECT_URL=

# Encrypts calendar tokens at rest (AES-256-GCM). Required with Google keys, and once
# any calendar is connected the server refuses to start without it.
# Generate one with: openssl rand -hex 32
CALENDAR_ENC_KEY=

# Public https:// base URL Google can reach for push notifications. Unset, calendars are
# polled every 5 minutes instead, so local development needs no tunnel.
# PUBLIC_URL=https://brew.example.com

# ---- Planning assistant (plain-language requests) --------------------------------------
# Unset, the assistant is off and the planning form does the same job.
ANTHROPIC_API_KEY=
# A small, fast model: this is structured extraction, not open-ended reasoning.
# ASSISTANT_MODEL=claude-haiku-5-5
# Per-user daily token budget for the assistant (input plus output tokens). A request
# averaged about 5,900 tokens in the eval, so the default allows about 9 a day.
# ASSISTANT_DAILY_TOKENS=50000
# output_config.effort for the model; "default" sends none (needed for models without effort).
# ASSISTANT_EFFORT=low

# Optional overrides.
# ADDR=:5001
# DB_PATH=brewfocus.db
# DEMO=true   # seed demo@brewfocus.dev (password: brewfocus) with a fake calendar

# Test doubles for the end-to-end test. Never set these in production.
# CALENDAR_PROVIDER=fake     # "connect" an in-memory calendar instead of Google
# ASSISTANT_PROVIDER=stub    # a phrase-matching stand-in for the model
