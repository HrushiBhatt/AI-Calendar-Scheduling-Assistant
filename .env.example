# This is only a template, and git tracks it: never put real keys in this file.
# Copy it to .env (which git ignores) and fill in real values there. `make api`, `make serve`
# and `docker compose up` all read .env.

# Signs the JWTs in login cookies. At least 32 bytes. With GIN_MODE=release, which Docker uses,
# the server won't start without it. Elsewhere it makes a random key, so everyone is logged out
# when it restarts. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Set to true when served over HTTPS: cookies then only travel over encrypted connections, and
# browsers are told to use HTTPS from now on. Leave it false to try the app on http://localhost.
SECURE_COOKIES=false

# Behind a reverse proxy or a hosting platform, list its addresses or CIDR ranges, comma
# separated. Rate limits need each visitor's real address, and only these may report it.
# TRUSTED_PROXIES=

# Optional overrides.
# ADDR=
# DB_PATH=
