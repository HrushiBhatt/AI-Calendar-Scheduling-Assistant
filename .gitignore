# ---- secrets & local config: never commit these -------------------------------
# The app needs none of these, but they should never reach the repo by accident.
# CI also scans every commit with gitleaks, in case something gets past these rules.
.env
.env.*
.envrc
.netrc
.npmrc
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der
*.gpg
*.asc
id_rsa*
id_ed25519*
*.secret
*.secrets
secrets/
.secrets/

# Google Cloud downloads its OAuth client and service account keys as JSON files.
client_secret*.json
credentials*.json
service-account*.json
*-service-account.json
token.json
tokens.json

# ---- build output & dependencies ---------------------------------------------
node_modules/
frontend/dist/
frontend/.angular/
frontend/coverage/
frontend/out-tsc/
frontend/test-results/
frontend/playwright-report/
*.test
*.out
*.prof

# ---- editor & OS noise -------------------------------------------------------------
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
